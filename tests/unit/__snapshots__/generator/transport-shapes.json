{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "hosts-dns",
        "type": "hosts",
        "predefined": {
          "localhost": [
            "127.0.0.1",
            "::1"
          ]
        }
      },
      {
        "tag": "local-dns",
        "type": "local"
      },
      {
        "tag": "remote-dns",
        "type": "https",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "proxy"
      },
      {
        "tag": "direct-dns",
        "type": "https",
        "server": "223.5.5.5",
        "path": "/dns-query"
      }
    ],
    "strategy": "ipv4_only",
    "rules": [
      {
        "domain_suffix": [
          ".cn",
          ".baidu.com",
          ".qq.com",
          ".taobao.com",
          ".jd.com",
          ".alipay.com"
        ],
        "server": "direct-dns"
      }
    ],
    "final": "remote-dns"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "direct",
        "vless-httpupgrade",
        "vmess-httpupgrade",
        "trojan-ws-host",
        "trojan-grpc",
        "vless-stored-h2",
        "vless-stored-raw",
        "vless-tls-insecure-firefox",
        "vmess-fingerprint-none",
        "ss-obfs-local-http",
        "ss-obfs-local-tls",
        "ss-v2ray-plugin-websocket-tls",
        "ss-v2ray-plugin-quic-tls"
      ],
      "default": "vless-httpupgrade",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "vless-httpupgrade",
        "vmess-httpupgrade",
        "trojan-ws-host",
        "trojan-grpc",
        "vless-stored-h2",
        "vless-stored-raw",
        "vless-tls-insecure-firefox",
        "vmess-fingerprint-none",
        "ss-obfs-local-http",
        "ss-obfs-local-tls",
        "ss-v2ray-plugin-websocket-tls",
        "ss-v2ray-plugin-quic-tls"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "vless",
      "tag": "vless-httpupgrade",
      "server": "127.0.0.1",
      "server_port": 19193,
      "uuid": "2420e4a1-e97c-4780-a7a0-f47b2a402ba7",
      "tls": {
        "enabled": true,
        "server_name": "example.com"
      },
      "transport": {
        "type": "httpupgrade",
        "path": "/upgrade",
        "host": "cdn.example.com"
      }
    },
    {
      "type": "vmess",
      "tag": "vmess-httpupgrade",
      "server": "127.0.0.1",
      "server_port": 19194,
      "uuid": "2420e4a1-e97c-4780-a7a0-f47b2a402ba7",
      "alter_id": 0,
      "security": "auto",
      "transport": {
        "type": "httpupgrade",
        "path": "/upgrade"
      }
    },
    {
      "type": "trojan",
      "tag": "trojan-ws-host",
      "server": "127.0.0.1",
      "server_port": 19195,
      "password": "trojan-password",
      "tls": {
        "enabled": true,
        "server_name": "example.com"
      },
      "transport": {
        "type": "ws",
        "path": "/ws",
        "headers": {
          "Host": "cdn.example.com"
        }
      }
    },
    {
      "type": "trojan",
      "tag": "trojan-grpc",
      "server": "127.0.0.1",
      "server_port": 19196,
      "password": "trojan-password",
      "tls": {
        "enabled": true,
        "server_name": "example.com"
      },
      "transport": {
        "type": "grpc",
        "service_name": "grpc-svc"
      }
    },
    {
      "type": "vless",
      "tag": "vless-stored-h2",
      "server": "127.0.0.1",
      "server_port": 19197,
      "uuid": "2420e4a1-e97c-4780-a7a0-f47b2a402ba7",
      "tls": {
        "enabled": true,
        "server_name": "example.com"
      },
      "transport": {
        "type": "http",
        "path": "/h2",
        "host": [
          "h2.example.com"
        ]
      }
    },
    {
      "type": "vless",
      "tag": "vless-stored-raw",
      "server": "127.0.0.1",
      "server_port": 19198,
      "uuid": "2420e4a1-e97c-4780-a7a0-f47b2a402ba7"
    },
    {
      "type": "vless",
      "tag": "vless-tls-insecure-firefox",
      "server": "127.0.0.1",
      "server_port": 19199,
      "uuid": "2420e4a1-e97c-4780-a7a0-f47b2a402ba7",
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "insecure": true,
        "utls": {
          "enabled": true,
          "fingerprint": "firefox"
        }
      }
    },
    {
      "type": "vmess",
      "tag": "vmess-fingerprint-none",
      "server": "127.0.0.1",
      "server_port": 19193,
      "uuid": "2420e4a1-e97c-4780-a7a0-f47b2a402ba7",
      "alter_id": 0,
      "security": "auto",
      "tls": {
        "enabled": true,
        "server_name": "example.com"
      }
    },
    {
      "type": "shadowsocks",
      "tag": "ss-obfs-local-http",
      "server": "127.0.0.1",
      "server_port": 19194,
      "method": "aes-128-gcm",
      "password": "ss-password",
      "plugin": "obfs-local",
      "plugin_opts": "obfs=http;obfs-host=www.bing.com"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-obfs-local-tls",
      "server": "127.0.0.1",
      "server_port": 19195,
      "method": "aes-128-gcm",
      "password": "ss-password",
      "plugin": "obfs-local",
      "plugin_opts": "obfs=tls;obfs-host=www.bing.com"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-v2ray-plugin-websocket-tls",
      "server": "127.0.0.1",
      "server_port": 19196,
      "method": "aes-128-gcm",
      "password": "ss-password",
      "plugin": "v2ray-plugin",
      "plugin_opts": "mode=websocket;host=cdn.example.com;path=/ws;tls"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-v2ray-plugin-quic-tls",
      "server": "127.0.0.1",
      "server_port": 19197,
      "method": "aes-128-gcm",
      "password": "ss-password",
      "plugin": "v2ray-plugin",
      "plugin_opts": "mode=quic;tls;host=cdn.example.com"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "domain": [
          "localhost"
        ],
        "action": "resolve",
        "server": "hosts-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain": [
          "localhost"
        ],
        "domain_suffix": [
          ".localhost",
          ".local",
          ".internal",
          ".lan",
          ".home.arpa"
        ],
        "domain_regex": [
          "^[^.]+$"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          ".cn",
          ".baidu.com",
          ".qq.com",
          ".taobao.com",
          ".jd.com",
          ".alipay.com"
        ],
        "outbound": "direct"
      }
    ],
    "rule_set": [],
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "local-dns",
      "strategy": "prefer_ipv4"
    },
    "final": "proxy"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:19191",
      "external_ui": "",
      "secret": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
    },
    "cache_file": {
      "enabled": true,
      "path": "C:\\awesome-proxy-test\\cache.db"
    }
  }
}